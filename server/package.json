{
  "name": "paimana-server",
  "version": "0.1.0",
  "private": true,
  "description": "Paimana API: lab-report extraction and range checking",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "fixtures": "tsx scripts/generate-fixtures.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.7",
    "pdfkit": "^0.20.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
